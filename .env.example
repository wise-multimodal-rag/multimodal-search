# OpenSearch Configuration
OPENSEARCH_HOST=
OPENSEARCH_PORT=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# OpenSearch Index Configuration
OPENSEARCH_MEDIA_INDEX=multimodal_rag_media
OPENSEARCH_CHUNK_INDEX=multimodal_rag_chunk
OPENSEARCH_ELEMENTS_INDEX=multimodal_rag_element

# External API Configuration
EMBEDDING_API_URL=
FEATURE_EXTRACTION_API_URL=
MULTIMODAL_API_KEY=

# LiteLLM Configuration - Query Analysis & Processing
LITELLM_URL=
LITELLM_API_KEY=
LITELLM_MODEL=gemini/gemini-2.5-pro

# LiteLLM Configuration - Generation
LITELLM_GENERATION_MODEL=bedrock/apac.anthropic.claude-sonnet-4-20250514-v1:0

# Langfuse Configuration - Prompt Management
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# Application Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info
DEBUG=false

# Storage Configuration
STORAGE_PATH=/storage

# Weight Configuration (Optional - defaults are provided)
# Core weight settings - all other weights are calculated from these
WEIGHT_QUERY_DECAY=0.1

# Element type default weights
WEIGHT_PARAGRAPH_DEFAULT=0.8
WEIGHT_SUMMARY_DEFAULT=0.6
WEIGHT_CAPTION_DEFAULT=0.3
WEIGHT_ORIGIN_DEFAULT=1.0

# === Core Search Strength Settings (0.0~1.0) ===
# Text search strength: Higher = prioritize text-based search
WEIGHT_TEXT_STRENGTH=0.7

# Image search strength: Higher = prioritize image-based search  
WEIGHT_IMAGE_STRENGTH=0.8

# Vector boost strength: Controls overall vector search weighting (0.5~3.0)
WEIGHT_VECTOR_BOOST_STRENGTH=1.5