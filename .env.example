# 복사해서 쓴다: cp .env.example .env
# 값은 비워 두었다. 비운 항목은 app/config/config.py · app/config/weights.py 의 기본값을 쓴다.
# 외부 API 항목은 기본값이 없다 — 비어 있으면 기동 로그에 '주입 필요' 경고가 뜬다.
# 실제 주소 · 키는 .env 에만 넣는다(.env 는 .gitignore 대상).

# OpenSearch
OPENSEARCH_HOST=
OPENSEARCH_PORT=
OPENSEARCH_USE_SSL=
OPENSEARCH_VERIFY_CERTS=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# OpenSearch 인덱스 이름
OPENSEARCH_MEDIA_INDEX=
OPENSEARCH_CHUNK_INDEX=
OPENSEARCH_ELEMENTS_INDEX=

# 외부 API — 주소 · 경로 · 인증 헤더 전부 주입. 요청 URL = <..._URL><..._PATH>
EMBEDDING_API_URL=
EMBEDDING_API_EMBED_PATH=
EMBEDDING_API_CAPTION_PATH=
FEATURE_EXTRACTION_API_URL=
FEATURE_API_SUMMARY_PATH=
FEATURE_API_KEYWORD_PATH=
FEATURE_API_ENTITIES_PATH=
MULTIMODAL_API_KEY=
MULTIMODAL_API_KEY_HEADER=

# LiteLLM — 질의 분석
LITELLM_URL=
LITELLM_CHAT_PATH=
LITELLM_API_KEY=
LITELLM_MODEL=

# LiteLLM — 답변 생성
LITELLM_GENERATION_MODEL=
LITELLM_TIMEOUT=

# Langfuse — 프롬프트 관리(선택). 키가 없으면 내장 기본 프롬프트를 쓴다
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_ENABLED=

# Reranker — vLLM /classify (선택). RERANKER_API_URL 이 비면 리랭킹을 건너뛴다
RERANKER_ENABLED=
RERANKER_API_URL=
RERANKER_CLASSIFY_PATH=
RERANKER_MODEL=
RERANKER_TIMEOUT=
RERANKER_TOP_K=
RERANKER_WEIGHT=
RERANKER_OVERSAMPLE=
RERANKER_MODALITY_BOOST=

# 이미지 경로(origins/...)만 있는 결과의 미리보기 프록시 주소(선택). 비우면 미리보기 생략
IMAGE_PROXY_URL=

# 애플리케이션
APP_HOST=
APP_PORT=
LOG_LEVEL=
DEBUG=

# 저장소
STORAGE_PATH=

# 검색 가중치(선택)
WEIGHT_QUERY_DECAY=
WEIGHT_PARAGRAPH_DEFAULT=
WEIGHT_SUMMARY_DEFAULT=
WEIGHT_CAPTION_DEFAULT=
WEIGHT_ORIGIN_DEFAULT=
WEIGHT_TEXT_STRENGTH=
WEIGHT_IMAGE_STRENGTH=
WEIGHT_VECTOR_BOOST_STRENGTH=
