# OpenSearch Configuration
OPENSEARCH_HOST=
OPENSEARCH_PORT=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# OpenSearch Index Configuration
OPENSEARCH_MEDIA_INDEX=multimodal_rag_media
OPENSEARCH_CHUNK_INDEX=multimodal_rag_chunk
OPENSEARCH_ELEMENTS_INDEX=multimodal_rag_element

# External API Configuration
EMBEDDING_API_URL=
FEATURE_EXTRACTION_API_URL=
MULTIMODAL_API_KEY=

# LiteLLM Configuration - Query Analysis & Processing
LITELLM_URL=
LITELLM_API_KEY=
LITELLM_MODEL=gemini/gemini-2.5-pro

# LiteLLM Configuration - Generation
LITELLM_GENERATION_MODEL=bedrock/apac.anthropic.claude-sonnet-4-20250514-v1:0

# Application Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info
DEBUG=false

# Storage Configuration
STORAGE_PATH=/storage

# Weight Configuration (Optional - defaults are provided)
# Query weight settings
WEIGHT_QUERY_DECAY=0.1

# Element type default weights
WEIGHT_PARAGRAPH_DEFAULT=0.8
WEIGHT_SUMMARY_DEFAULT=0.6
WEIGHT_CAPTION_DEFAULT=0.3
WEIGHT_ORIGIN_DEFAULT=1.0

# Text analysis weights
WEIGHT_TEXT_SUMMARY_BASE=0.8
WEIGHT_TEXT_SUMMARY_BOOST=0.1
WEIGHT_TEXT_PARAGRAPH_BASE=0.7
WEIGHT_TEXT_PARAGRAPH_PENALTY=0.1
WEIGHT_TEXT_MIN=0.4
WEIGHT_TEXT_PARAGRAPH_DEFAULT=0.8
WEIGHT_TEXT_SUMMARY_DEFAULT=0.6

# Image analysis weights
WEIGHT_IMAGE_ORIGIN=1.0
WEIGHT_IMAGE_CAPTION_BASE=0.3
WEIGHT_IMAGE_CAPTION_BOOST=0.05
WEIGHT_IMAGE_CAPTION_MAX=0.4
WEIGHT_IMAGE_CAPTION_MIN=0.2

# Universal defaults
WEIGHT_UNIVERSAL_DEFAULT=0.6
WEIGHT_OPENSEARCH_DEFAULT=1.0

# Priority thresholds
WEIGHT_HIGH_PRIORITY_THRESHOLD=0.8
WEIGHT_MEDIUM_PRIORITY_THRESHOLD=0.5
WEIGHT_LOW_PRIORITY_THRESHOLD=0.0